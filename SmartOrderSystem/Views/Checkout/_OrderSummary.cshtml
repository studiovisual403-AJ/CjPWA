@model SmartOrderSystem.ViewModels.CheckoutOrderSummaryViewModel

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h5 class="fw-bold mb-3">Order Summary</h5>

        @if (Model.Items.Any())
        {
            @foreach (var item in Model.Items)
            {
                <div class="d-flex gap-3 mb-3">
                    <img src="@(item.ImagePath ?? "/images/no-image.png")" class="rounded border" style="width:70px;height:70px;object-fit:contain;" />
                    <div>
                        <h6 class="fw-bold mb-1">@item.ShoeName</h6>
                        <div class="text-muted small">@item.Brand</div>
                        <div class="text-muted small">Size @item.Size · Qty: @item.Quantity</div>
                    </div>
                    <div class="ms-auto fw-bold">₱@item.LineTotal.ToString("N2")</div>
                </div>
            }
        }
        else
        {
            <div class="d-flex gap-3 mb-3">
                <img src="@(Model.ImagePath ?? "/images/no-image.png")" class="rounded border" style="width:70px;height:70px;object-fit:contain;" />
                <div>
                    <h6 class="fw-bold mb-1">@Model.ShoeName</h6>
                    <div class="text-muted small">@Model.Brand</div>
                    <div class="text-muted small">Size @Model.Size.ToString("0.#") · Qty: @Model.Quantity</div>
                </div>
                <div class="ms-auto fw-bold">₱@((Model.UnitPrice * Model.Quantity).ToString("N2"))</div>
            </div>
        }

        <hr />

        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Merchandise Subtotal</span>
            <span>₱@Model.Subtotal.ToString("N2")</span>
        </div>
        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Shipping Fee</span>
            <span>@(Model.ShippingFee == 0 ? "FREE" : $"₱{Model.ShippingFee:N2}")</span>
        </div>

        <hr />

        <div class="d-flex justify-content-between align-items-center">
            <span class="fw-bold">Total</span>
            <span class="fw-bold text-danger fs-5">₱@Model.Total.ToString("N2")</span>
        </div>

        <div class="alert alert-light border mt-3 small mb-0">
            <i class="ti ti-shield-check me-1"></i> <strong>Secure Checkout</strong><br />
            Your transaction is protected with industry-standard security.
        </div>
    </div>
</div>