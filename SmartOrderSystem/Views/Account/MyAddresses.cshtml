@model List<SmartOrderSystem.Models.CustomerAddress>
@{
    Layout = "~/Views/Shared/_ShopLayout.cshtml";
    ViewData["Title"] = "My Addresses";
}

<div class="shop-container py-4">
    <div class="ma-breadcrumb">
        <a asp-controller="Shop" asp-action="Index">Home</a> /
        <a asp-controller="Account" asp-action="MyAccount">My Account</a> /
        <span>My Addresses</span>
    </div>

    <h1 class="ma-page-title">My Addresses</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="ma-layout">
        <aside class="ma-sidebar">
            <nav class="ma-sidebar-nav">
                <a asp-controller="Account" asp-action="MyAccount" class="ma-nav-link"><i class="ti ti-user"></i> My Profile</a>
                <a asp-controller="Order" asp-action="Index" class="ma-nav-link"><i class="ti ti-shopping-bag"></i> My Orders</a>
                <a asp-controller="Reservation" asp-action="Index" class="ma-nav-link"><i class="ti ti-calendar"></i> My Reservations</a>
                <a asp-controller="Account" asp-action="MyAddresses" class="ma-nav-link active"><i class="ti ti-map-pin"></i> My Addresses</a>
                <hr class="ma-sidebar-divider" />
                <a asp-controller="Account" asp-action="Logout" class="ma-nav-link ma-logout"><i class="ti ti-logout"></i> Logout</a>
            </nav>
        </aside>

        <div class="ma-main">
            <div class="ma-addr-card">
                <div class="ma-addr-header">
                    <div>
                        <h2>My Addresses</h2>
                        <p class="text-muted mb-0">Manage your saved shipping addresses.</p>
                    </div>
                    <button type="button" class="ma-addr-add-btn" onclick="openAddressModal()">
                        <i class="ti ti-plus"></i> Add New Address
                    </button>
                </div>

                @if (Model.Any())
                {
                    <div class="ma-addr-list">
                        @foreach (var address in Model)
                        {
                            <div class="ma-addr-item @(address.is_default ? "is-default" : "")">
                                <div class="ma-addr-radio">
                                    <i class="ti @(address.is_default ? "ti-circle-check-filled" : "ti-circle")"></i>
                                </div>

                                <div class="ma-addr-body">
                                    <div class="ma-addr-title-row">
                                        <span class="ma-addr-label">@address.address_type</span>
                                        @if (address.is_default)
                                        {
                                            <span class="ma-badge-default">Default</span>
                                        }
                                    </div>
                                    <div class="ma-addr-recipient">@address.recipient_name</div>
                                    <div class="ma-addr-phone"><i class="ti ti-phone"></i> @address.contact_number</div>
                                    <div class="ma-addr-lines">
                                        <i class="ti ti-map-pin"></i>
                                        <span>
                                            @address.street_address, @address.barangay, @address.city,
                                            @address.province
                                            @if (!string.IsNullOrWhiteSpace(address.postal_code))
                                            {
                                                <span>, @address.postal_code</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(address.landmark))
                                            {
                                                <br />
                                                <span class="text-muted">Landmark: @address.landmark</span>
                                            }
                                        </span>
                                    </div>
                                </div>

                                <div class="ma-addr-actions">
                                    @if (!address.is_default)
                                    {
                                        <form asp-controller="Account" asp-action="SetDefaultAddress" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@address.address_id" />
                                            <button type="submit" class="ma-btn-outline">Set as Default</button>
                                        </form>
                                    }
                                    <button type="button" class="ma-icon-btn" title="Edit" onclick="openAddressModal(@address.address_id)">
                                        <i class="ti ti-pencil"></i>
                                    </button>
                                    <form asp-controller="Account" asp-action="DeleteAddress" method="post" class="ma-addr-delete-form" onsubmit="return confirm('Delete this address?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@address.address_id" />
                                        <button type="submit" class="ma-icon-btn ma-icon-btn-danger" title="Delete">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="ma-addr-empty">
                        <i class="ti ti-map-pin-off"></i>
                        <p class="text-muted mb-0">You have no saved addresses yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Address Modal -->
<div class="modal fade" id="addressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Account" asp-action="SaveAddress" method="post" id="addressForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="AddressId" id="AddressId" value="0" />

                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="addressModalTitle">Add New Address</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Address Type <span class="text-danger">*</span></label>
                        <select name="AddressType" id="AddressType" class="form-select" required>
                            <option value="Home">Home</option>
                            <option value="Work">Work</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Full Name <span class="text-danger">*</span></label>
                        <input type="text" name="RecipientName" id="RecipientName" class="form-control" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Contact Number <span class="text-danger">*</span></label>
                            <input type="text" name="ContactNumber" id="ContactNumber" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">City / Municipality <span class="text-danger">*</span></label>
                            <input type="text" name="City" id="City" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Street Address <span class="text-danger">*</span></label>
                        <input type="text" name="StreetAddress" id="StreetAddress" class="form-control" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Province <span class="text-danger">*</span></label>
                            <input type="text" name="Province" id="Province" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Barangay <span class="text-danger">*</span></label>
                            <input type="text" name="Barangay" id="Barangay" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-1">
                        <label class="form-label">Landmark (Optional)</label>
                        <input type="text" name="Landmark" id="Landmark" class="form-control" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function resetAddressForm() {
            document.getElementById('addressForm').reset();
            document.getElementById('AddressId').value = 0;
            document.getElementById('addressModalTitle').innerText = 'Add New Address';
        }

        function openAddressModal(addressId) {
            resetAddressForm();

            if (addressId) {
                fetch('/Account/GetAddress?id=' + addressId)
                    .then(res => res.json())
                    .then(data => {
                        document.getElementById('addressModalTitle').innerText = 'Edit Address';
                        document.getElementById('AddressId').value = data.addressId;
                        document.getElementById('AddressType').value = data.addressType;
                        document.getElementById('RecipientName').value = data.recipientName;
                        document.getElementById('ContactNumber').value = data.contactNumber;
                        document.getElementById('City').value = data.city;
                        document.getElementById('StreetAddress').value = data.streetAddress;
                        document.getElementById('Province').value = data.province;
                        document.getElementById('Barangay').value = data.barangay;
                        document.getElementById('Landmark').value = data.landmark ?? '';

                        var modal = new bootstrap.Modal(document.getElementById('addressModal'));
                        modal.show();
                    })
                    .catch(() => alert('Failed to load address details.'));
            } else {
                var modal = new bootstrap.Modal(document.getElementById('addressModal'));
                modal.show();
            }
        }
    </script>
}