@model SmartOrderSystem.ViewModels.ResetPasswordViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Your Password - CJ Shoes</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #f8fafc; display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 20px; }
        .card { background: #ffffff; width: 100%; max-width: 540px; padding: 40px 32px; border-radius: 20px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05); border: 1px solid #f1f5f9; }
        .icon-container { display: flex; justify-content: center; margin-bottom: 24px; }
        .icon-circle { width: 56px; height: 56px; background-color: #fef2f2; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #dc2626; }
        .icon-circle svg { width: 28px; height: 28px; }
        .text-center { text-align: center; margin-bottom: 28px; }
        .text-center h2 { font-size: 24px; font-weight: 700; color: #0f172a; margin-bottom: 8px; }
        .text-center p { font-size: 14px; color: #64748b; line-height: 1.5; }
        .form-group { margin-bottom: 20px; }
        .form-label { display: block; font-size: 14px; font-weight: 600; color: #1e293b; margin-bottom: 8px; }
        
        /* Updated Input Wrapper para sa Eye Icon */
        .input-wrapper { position: relative; display: flex; align-items: center; }
        .input-wrapper > svg:first-child { position: absolute; left: 14px; width: 18px; height: 18px; color: #94a3b8; pointer-events: none; }
        
        .form-control { width: 100%; padding: 11px 42px 11px 42px; background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 10px; font-size: 14px; color: #1e293b; outline: none; transition: all 0.2s; }
        .form-control:focus { background-color: #ffffff; border-color: #dc2626; box-shadow: 0 0 0 4px rgba(220, 38, 38, 0.1); }
        
        /* Style para sa Toggle Eye Button */
        .toggle-password { position: absolute; right: 14px; cursor: pointer; color: #94a3b8; display: flex; align-items: center; justify-content: center; width: 20px; height: 20px; user-select: none; }
        .toggle-password:hover { color: #1e293b; }
        .toggle-password svg { width: 18px; height: 18px; }

        .requirements-box { background-color: #fcf8f8; border: 1px solid #f1d6d6; border-radius: 12px; padding: 16px; margin-bottom: 24px; }
        .req-title { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #b91c1c; margin-bottom: 10px; }
        .req-title svg { width: 16px; height: 16px; }
        .req-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 12px; color: #475569; }
        .req-item { display: flex; align-items: center; gap: 6px; }
        .req-item svg { width: 14px; height: 14px; color: #16a34a; flex-shrink: 0; }
        .button-group { display: flex; gap: 12px; margin-top: 24px; }
        .btn-back { flex: 1; background: #ffffff; color: #334155; border: 1px solid #cbd5e1; padding: 12px; border-radius: 12px; font-size: 14px; font-weight: 600; cursor: pointer; text-align: center; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 6px; }
        .btn-back:hover { background: #f1f5f9; }
        .btn-reset { flex: 2; background: #b91c1c; color: white; border: none; padding: 12px; border-radius: 12px; font-size: 14px; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; }
        .btn-reset:hover { background: #991b1b; }
        .validation-summary-errors, .field-validation-error { color: #b91c1c; font-size: 12px; }
        .validation-summary-errors { margin-bottom: 16px; padding: 10px 12px; border: 1px solid #fecaca; border-radius: 8px; background: #fef2f2; }
        .field-validation-error { display: block; margin-top: 4px; }
    </style>
</head>
<body>

    <div class="card">
        <div class="icon-container">
            <div class="icon-circle">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>
        </div>

        <div class="text-center">
            <h2>Reset Your Password</h2>
            <p>Create a new password for your account.<br>Make sure it's strong and easy for you to remember.</p>
        </div>

        @using (Html.BeginForm("UpdatePassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

            <!-- New Password Field na may Eye Toggle -->
            <div class="form-group">
                <label class="form-label">New Password</label>
                <div class="input-wrapper">
                    <!-- Left Lock Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                    
                    <input asp-for="NewPassword" type="password" id="NewPassword" placeholder="Enter your new password" class="form-control" autocomplete="off" />
                    
                    <!-- Right Eye Icon Toggle -->
                    <span class="toggle-password" onclick="togglePassword('NewPassword', this)">
                        <svg id="eyeIcon-NewPassword" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </span>
                </div>
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
            </div>

            <!-- Confirm New Password Field na may Eye Toggle -->
            <div class="form-group">
                <label class="form-label">Confirm New Password</label>
                <div class="input-wrapper">
                    <!-- Left Lock Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                    
                    <input asp-for="ConfirmPassword" type="password" id="ConfirmPassword" placeholder="Confirm your new password" class="form-control" autocomplete="off" />
                    
                    <!-- Right Eye Icon Toggle -->
                    <span class="toggle-password" onclick="togglePassword('ConfirmPassword', this)">
                        <svg id="eyeIcon-ConfirmPassword" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </span>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

            <div class="requirements-box">
                <div class="req-title">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    Password Requirements
                </div>
                <div class="req-grid">
                    <div class="req-item">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        At least 8 characters
                    </div>
                    <div class="req-item">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        Contains lowercase letter (a-z)
                    </div>
                    <div class="req-item">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        Contains uppercase letter (A-Z)
                    </div>
                    <div class="req-item">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        Contains number (0-9)
                    </div>
                </div>
            </div>

            <div class="button-group">
                <a href="@Url.Action("ForgotPassword", "Account")" class="btn-back">
                    &larr; Back
                </a>
                <button type="submit" class="btn-reset">
                    Reset Password &rarr;
                </button>
            </div>
        }
    </div>

    <!-- JavaScript para sa Toggle Password Visibility -->
    <script>
        function togglePassword(fieldId, toggleElement) {
            const inputField = document.getElementById(fieldId);
            const eyeIcon = toggleElement.querySelector('svg');

            if (inputField.type === "password") {
                inputField.type = "text";
                // Palitan ang icon maging nakabukas/nakaslash ang mata
                eyeIcon.innerHTML = `
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                `;
            } else {
                inputField.type = "password";
                // Ibalik sa normal na itsura ng mata
                eyeIcon.innerHTML = `
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                `;
            }
        }
    </script>
</body>
</html>