@model SmartOrderSystem.ViewModels.ChangePasswordViewModel
@{
    Layout = "~/Views/Shared/_ShopLayout.cshtml"; // IWASTO base sa tunay na filename mo
    ViewData["Title"] = "Change Password";
}

<div class="ma-breadcrumb">
    <a asp-controller="Home" asp-action="Index">Home</a> /
    <a asp-controller="Account" asp-action="MyAccount">My Account</a> /
    <span>Change Password</span>
</div>

<div class="ma-layout">
    <!-- Sidebar (same as My Account) -->
    <aside class="ma-sidebar">
        <div class="ma-sidebar-profile">
            <div class="ma-avatar ma-avatar-placeholder">
                <i class="ti ti-user"></i>
            </div>
        </div>
        <nav class="ma-sidebar-nav">
            <a asp-controller="Account" asp-action="MyAccount" class="ma-nav-link"><i class="ti ti-user"></i> My Profile</a>
            <a asp-controller="Order" asp-action="Index" class="ma-nav-link"><i class="ti ti-shopping-bag"></i> My Orders</a>
            <a asp-controller="Reservation" asp-action="Index" class="ma-nav-link"><i class="ti ti-calendar"></i> My Reservations</a>
            <a asp-controller="Account" asp-action="MyAddresses" class="ma-nav-link"><i class="ti ti-map-pin"></i> My Addresses</a>
            <hr class="ma-sidebar-divider" />
            <a asp-controller="Account" asp-action="Logout" class="ma-nav-link ma-logout"><i class="ti ti-logout"></i> Logout</a>
        </nav>
    </aside>

    <div class="ep-main">
        <h1 class="ma-page-title">Change Password</h1>
        <p class="ep-subtitle">For your security, please use a strong password.</p>

        <div class="ep-content-grid">
            <form asp-controller="Account" asp-action="ChangePassword" method="post" class="ep-form-card" id="changePasswordForm">
                <h2>Update Your Password</h2>

                <label class="ep-label" asp-for="CurrentPassword">Current Password *</label>
                <div class="cp-input-wrap">
                    <input asp-for="CurrentPassword" type="password" class="ep-input" id="currentPassword" />
                    <i class="ti ti-eye cp-toggle-eye" data-target="currentPassword"></i>
                </div>
                <span asp-validation-for="CurrentPassword" class="ep-error"></span>
                <div class="cp-hint">Enter your current password to continue.</div>

                <label class="ep-label" asp-for="NewPassword">New Password *</label>
                <div class="cp-input-wrap">
                    <input asp-for="NewPassword" type="password" class="ep-input" id="newPassword" oninput="cpCheckStrength()" />
                    <i class="ti ti-eye cp-toggle-eye" data-target="newPassword"></i>
                </div>
                <span asp-validation-for="NewPassword" class="ep-error"></span>
                <div class="cp-hint">Must be at least 8 characters long.</div>

                <div class="cp-strength-row">
                    <span>Password Strength:</span>
                    <span id="cpStrengthLabel" class="cp-strength-label">—</span>
                </div>
                <div class="cp-strength-bar">
                    <div id="cpStrengthFill" class="cp-strength-fill"></div>
                </div>

                <label class="ep-label" asp-for="ConfirmNewPassword">Confirm New Password *</label>
                <div class="cp-input-wrap">
                    <input asp-for="ConfirmNewPassword" type="password" class="ep-input" id="confirmPassword" />
                    <i class="ti ti-eye cp-toggle-eye" data-target="confirmPassword"></i>
                </div>
                <span asp-validation-for="ConfirmNewPassword" class="ep-error"></span>
                <div class="cp-hint">Re-enter your new password.</div>

                <div class="ep-form-actions">
                    <a asp-controller="Account" asp-action="MyAccount" class="ep-btn-cancel">Cancel</a>
                    <button type="submit" class="ep-btn-save"><i class="ti ti-lock"></i> Update Password</button>
                </div>
            </form>

            <div class="ep-side-col">
                <div class="ep-tip-card">
                    <div class="ep-tip-icon ep-tip-icon-red"><i class="ti ti-shield-lock"></i></div>
                    <h3>Password Tips</h3>
                    <p>A strong password helps keep your account safe. Please follow these tips:</p>
                    <ul class="cp-tips-list">
                        <li><i class="ti ti-circle-check"></i> At least 8 characters long</li>
                        <li><i class="ti ti-circle-check"></i> Use a mix of letters and numbers</li>
                        <li><i class="ti ti-circle-check"></i> Include uppercase and lowercase letters</li>
                        <li><i class="ti ti-circle-check"></i> Avoid using personal information</li>
                    </ul>
                </div>
                <div class="cp-info-note">
                    <i class="ti ti-info-circle"></i>
                    For your security, you will be logged out from all devices after changing your password.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function cpCheckStrength() {
            const val = document.getElementById('newPassword').value;
            const fill = document.getElementById('cpStrengthFill');
            const label = document.getElementById('cpStrengthLabel');

            let score = 0;
            if (val.length >= 8) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[a-z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            let pct = (score / 5) * 100;
            let text = "Weak", color = "#E31C25";
            if (score >= 4) { text = "Strong"; color = "#1a9e5c"; }
            else if (score >= 2) { text = "Medium"; color = "#e0a800"; }

            fill.style.width = val.length === 0 ? "0%" : pct + "%";
            fill.style.background = color;
            label.textContent = val.length === 0 ? "—" : text;
            label.style.color = color;
        }

        document.querySelectorAll('.cp-toggle-eye').forEach(function (icon) {
            icon.addEventListener('click', function () {
                const input = document.getElementById(icon.dataset.target);
                if (input.type === "password") {
                    input.type = "text";
                    icon.classList.remove('ti-eye');
                    icon.classList.add('ti-eye-off');
                } else {
                    input.type = "password";
                    icon.classList.remove('ti-eye-off');
                    icon.classList.add('ti-eye');
                }
            });
        });
    </script>
}