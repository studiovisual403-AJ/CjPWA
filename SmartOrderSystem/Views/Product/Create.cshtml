@model SmartOrderSystem.ViewModels.AddProductViewModel
@{
    ViewData["Title"] = "Add Product";
    var categories = ViewData["Categories"] as string[] ?? Array.Empty<string>();
}

<div class="form-page">
    <a asp-action="Index" class="back-link">
        <i class="ti ti-arrow-left" aria-hidden="true"></i>
        Back to product catalog
    </a>

    <div class="form-card">
        <h2 class="form-card-title">Add new product</h2>

        <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <!-- Main Layout (Ito ang naghahati sa kaliwa at kanang column) -->
            <div class="form-layout">
                
                <!-- LEFT COLUMN: Basic Information & Product Image -->
                <div class="form-layout-column">
                    <div class="form-group">
                        <label asp-for="Brand">Brand</label>
                        <input asp-for="Brand" placeholder="e.g. Nike" class="form-input" />
                        <span asp-validation-for="Brand" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ModelName">Model</label>
                        <input asp-for="ModelName" placeholder="e.g. Air Max 90" class="form-input" />
                        <span asp-validation-for="ModelName" class="field-error"></span>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Color">Color Variant</label>
                            <input asp-for="Color" placeholder="e.g. Triple Black" class="form-input" />
                            <span asp-validation-for="Color" class="field-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Category">Category</label>
                            <select asp-for="Category" class="form-select">
                                @foreach (var c in categories)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                            <span asp-validation-for="Category" class="field-error"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="DefaultPrice">Base price (₱)</label>
                            <input asp-for="DefaultPrice" type="number" step="0.01" min="0" placeholder="0.00" class="form-input" />
                            <span asp-validation-for="DefaultPrice" class="field-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Status">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group form-group-spaced">
                        <label asp-for="ProductImage">Product Image</label>
                        
                        <div class="drag-drop-zone"
                             onclick="document.getElementById('ProductImage').click()"
                             ondragover="event.preventDefault()"
                             ondrop="handleFileDrop(event)">

                            <img id="image-preview"
                                 src="/images/no-image.png"
                                 alt="Preview"
                                 class="upload-preview" />

                            <div id="upload-placeholder">
                                <i class="ti ti-upload-cloud upload-icon"></i>
                                <div class="drag-drop-text">
                                    <span class="fw-bold upload-help-text">Click to upload</span>
                                    or drag & drop image here
                                </div>
                                <small class="upload-hint">JPG, PNG or WEBP. Max size 5MB.</small>
                            </div>

                            <div id="file-name-display" class="upload-file-name"></div>

                            <div id="image-actions" class="upload-action-row">
                                <button type="button" class="btn btn-outline-primary btn-sm" onclick="changeImage(event)">
                                    <i class="ti ti-photo"></i> Change Image
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeImage(event)">
                                    <i class="ti ti-trash"></i> Remove
                                </button>
                            </div>
                        </div>

                        <input asp-for="ProductImage"
                               type="file"
                               class="form-input"
                               id="ProductImage"
                               accept=".jpg,.jpeg,.png,.webp"
                               style="display: none;"
                               onchange="displayFileName(this.files[0])" />

                        <span asp-validation-for="ProductImage" class="field-error"></span>
                    </div>
                </div>

                <!-- RIGHT COLUMN: Initial Stock per Size -->
                <div class="form-side-panel">
                    <label class="fw-bold form-side-panel-title">Initial Stock per Size</label>
                    
                    <div class="form-size-grid">
                        @for (int size = 36; size <= 45; size++)
                        {
                            <div class="form-size-card">
                                <span>@size</span>
                                <input type="number" 
                                       name="SizesWithStocks[@size]" 
                                       class="form-input" 
                                       value="0" 
                                       min="0" />
                            </div>
                        }
                    </div>
                </div>

            </div>

            <!-- Action Buttons Footer -->
            <div class="form-actions form-actions-bar">
                <a asp-action="Index" class="btn-secondary">Cancel</a>
                <button type="submit" class="btn-secondary">Add product</button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/product-form.js" asp-append-version="true"></script>
}