@* Views/Shared/_AdminLayout.cshtml *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – CJ Shoes Admin</title>

    @* Tabler Icons CDN *@
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" />
    <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" integrity="sha512-9usAa10IRO0HhonpyAIVpjrylPvoDwiPUiKdWk5t3PyolY1cOd4DSE0Ga+ri4AuTroPR5aQvXU9xC6qOPnzFeg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Chart.js (Ang kailangan para sa Sales Trend) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @* Shared admin styles *@
    <link rel="stylesheet" href="~/css/admin-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body>

<div class="admin-wrap">

    @* ════════ SIDEBAR ════════ *@
    <aside class="sidebar" id="sidebar">

        <div class="sidebar-logo">
            <i class="ti ti-shoe" aria-hidden="true"></i>
            <div class="sidebar-logo-text">
                <span>CJ SHOES</span>
                <small>ADMIN PORTAL</small>
            </div>
        </div>

        <nav class="sidebar-nav" aria-label="Admin navigation">

            <p class="nav-section-label">Main</p>

            <a asp-controller="Dashboard" asp-action="Index"
               class="nav-item @(IsActive("Dashboard"))">
                <i class="ti ti-layout-dashboard" aria-hidden="true"></i>
                <span>Dashboard</span>
            </a>

            <p class="nav-section-label">Catalog</p>

           <a asp-controller="Product" asp-action="Index"
               class="nav-item @(IsActive("Product"))">
                <i class="ti ti-shopping-bag" aria-hidden="true"></i>
                <span>Product Catalog</span>
            </a>

            <a asp-controller="Inventory" asp-action="Index"
               class="nav-item @(IsActive("Inventory"))">
                <i class="ti ti-stack-2" aria-hidden="true"></i>
                <span>Shoe Inventory</span>
            </a>

            <p class="nav-section-label">Transactions</p>

            <a asp-controller="OrdersManagement" asp-action="Index"
               class="nav-item @(IsActive("OrdersManagement"))">
                <i class="ti ti-clipboard-list" aria-hidden="true"></i>
                <span>Orders Management</span>
            </a>

            <a asp-controller="ReservationManagement" asp-action="Index"
               class="nav-item @(IsActive("ReservationManagement"))">
                <i class="ti ti-calendar-check" aria-hidden="true"></i>
                <span>Reservations</span>
            </a>

            <p class="nav-section-label">Reports</p>

            <a asp-controller="Sales" asp-action="Index"
               class="nav-item @(IsActive("Sales"))">
                <i class="ti ti-chart-bar" aria-hidden="true"></i>
                <span>Sales & Reports</span>
            </a>

        </nav>

        <div class="sidebar-footer">
            <div class="avatar">A</div>
            <div class="sidebar-footer-info">
                <p>Administrator</p>
                <small>@User.Identity?.Name</small>
            </div>
            <a asp-controller="AdminAccount" asp-action="Logout"
               class="sidebar-logout" title="Log out" aria-label="Log out">
                <i class="ti ti-logout" aria-hidden="true"></i>
            </a>
        </div>

    </aside>

    @* ════════ MAIN ════════ *@
    <div class="admin-main" id="adminMain">

        @* TOP BAR *@
        <header class="topbar">
            <button class="topbar-hamburger" id="sidebarToggle"
                    aria-label="Toggle sidebar" aria-expanded="false"
                    aria-controls="sidebar">
                <i class="ti ti-menu-2" aria-hidden="true"></i>
            </button>

            <div class="topbar-title">
                <strong>CJ SHOES</strong>
                <small>Inventory &amp; Order Management</small>
            </div>

            <div class="topbar-right">
                <a class="topbar-icon-btn" title="Notifications" aria-label="Notifications" asp-controller="AdminAccount" asp-action="Notifications">
                    <i class="ti ti-bell" aria-hidden="true"></i>
                    <span class="notif-dot" aria-hidden="true"></span>
                </a>
                <a class="topbar-icon-btn" title="Settings" aria-label="Settings" asp-controller="AdminAccount" asp-action="Settings">
                    <i class="ti ti-settings" aria-hidden="true"></i>
                </a>
                <a class="admin-profile-btn text-decoration-none" asp-controller="AdminAccount" asp-action="Profile">
                    <div class="avatar sm"></div>
                    <span>Admin Profile</span>
                    <i class="ti ti-chevron-down" aria-hidden="true"></i>
                </a>
            </div>
        </header>

        @* PAGE CONTENT *@
        <main class="admin-content" id="main-content">
            @RenderBody()
        </main>

        @* FOOTER *@
        <footer class="admin-footer">
            <span>&copy; @DateTime.Now.Year CJ Shoes. All rights reserved.</span>
            <span>Progressive Web Application Version 1.0</span>
        </footer>

    </div>
</div>

<div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

<script src="~/js/admin-sidebar.js" asp-append-version="true"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)

</body>

</html>

@functions {
    string IsActive(string controller)
    {
        var current = ViewContext.RouteData.Values["controller"]?.ToString();

        return string.Equals(current, controller, StringComparison.OrdinalIgnoreCase)
               ? "active"
               : "";
    }
}